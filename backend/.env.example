DATABASE_URL="mysql://root:rootpassword@localhost:3307/reachinbox_db"
# Set REDIS_URL for hosted Redis; otherwise use REDIS_HOST and REDIS_PORT.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=5000
FRONTEND_URL=http://localhost:5173
# Use "none" only when frontend and backend are on different sites; production requires HTTPS.
SESSION_COOKIE_SAME_SITE=lax
# In local development, the API also accepts Vite's fallback port 5175.
# In production, only FRONTEND_URL is allowed.
ENABLE_LOCAL_DEMO_LOGIN=false

SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:5000/auth/slack/callback

SMTP_SENDERS=[{"id":"ethereal-1","name":"Ethereal sender","from":"Demo <your-ethereal-user@ethereal.email>","host":"smtp.ethereal.email","port":587,"user":"your-ethereal-user@ethereal.email","pass":"your-ethereal-password"}]

WORKER_CONCURRENCY=5
EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_API_KEY=
# Alternatively, set both ELASTICSEARCH_USERNAME and ELASTICSEARCH_PASSWORD.
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
